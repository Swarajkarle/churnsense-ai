# ─── Application ──────────────────────────────────────────────
APP_NAME=ChurnSense AI
APP_ENV=development
DEBUG=true

# ─── Backend ──────────────────────────────────────────────────
SECRET_KEY=your-super-secret-jwt-key-change-in-production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=7

# ─── Database ─────────────────────────────────────────────────
DATABASE_URL=postgresql+asyncpg://user:password@localhost:5432/churnsense
SYNC_DATABASE_URL=postgresql://user:password@localhost:5432/churnsense

# ─── Supabase (optional, use instead of raw PostgreSQL) ───────
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# ─── CORS ─────────────────────────────────────────────────────
ALLOWED_ORIGINS=http://localhost:3000,https://your-frontend.vercel.app

# ─── File Upload ──────────────────────────────────────────────
UPLOAD_DIR=./uploads
MAX_UPLOAD_SIZE_MB=50

# ─── ML ───────────────────────────────────────────────────────
MODEL_STORE_PATH=./ml/models
MAX_TRAINING_TIME_SECONDS=300

# ─── Frontend ─────────────────────────────────────────────────
NEXT_PUBLIC_API_URL=http://localhost:8000/api/v1
NEXT_PUBLIC_APP_NAME=ChurnSense AI
NEXT_PUBLIC_APP_VERSION=1.0.0
